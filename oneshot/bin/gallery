#!/usr/bin/env python3
"""Build a self-contained HTML gallery from results/index.json.

SVGs are inlined; HTML artifacts go into sandboxed iframes via srcdoc, so the
generated games actually run inside the page.
"""
import json, os, html, argparse
ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

CSS = """
:root{--paper:#faf9f7;--surface:#fff;--sunk:#f0eeea;--ink:#1a1815;--body:#3d3a35;
--mute:#6b665e;--faint:#9a948a;--rule:#e2ded7;--accent:#a85c32;--ok:#3f7a52;--bad:#b04a3a;}
@media(prefers-color-scheme:dark){:root:not([data-theme=light]){
--paper:#14130f;--surface:#1c1a16;--sunk:#191713;--ink:#f2efe9;--body:#c9c3b8;
--mute:#948d81;--faint:#6e685e;--rule:#2b2822;--accent:#d4885a;--ok:#6fae83;--bad:#dd8272;}}
:root[data-theme=dark]{--paper:#14130f;--surface:#1c1a16;--sunk:#191713;--ink:#f2efe9;
--body:#c9c3b8;--mute:#948d81;--faint:#6e685e;--rule:#2b2822;--accent:#d4885a;--ok:#6fae83;--bad:#dd8272;}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--body);
font:16px/1.6 "Iowan Old Style",Palatino,Georgia,serif}
.wrap{max-width:1180px;margin:0 auto;padding:0 24px}
header{border-bottom:1px solid var(--rule);background:var(--surface);padding:52px 0 34px;margin-bottom:40px}
h1{font-family:"Helvetica Neue",Arial,sans-serif;font-weight:700;letter-spacing:-.025em;
font-size:clamp(2rem,5vw,3rem);margin:0 0 12px;color:var(--ink)}
.sub{color:var(--mute);max-width:62ch;margin:0}
.meta{font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--faint);margin-top:20px}
.card{background:var(--surface);border:1px solid var(--rule);border-radius:4px;
margin-bottom:34px;overflow:hidden}
.head{padding:20px 24px;border-bottom:1px solid var(--rule);display:flex;
flex-wrap:wrap;gap:14px;align-items:baseline}
h2{font-family:"Helvetica Neue",Arial,sans-serif;font-size:1.2rem;margin:0;color:var(--ink);
letter-spacing:-.01em}
.why{padding:16px 24px;color:var(--mute);font-size:.94rem;border-bottom:1px solid var(--rule);
background:var(--sunk)}
.stats{font-family:ui-monospace,Menlo,monospace;font-size:11.5px;color:var(--faint);
margin-left:auto;font-variant-numeric:tabular-nums}
.badge{font-family:ui-monospace,monospace;font-size:10px;letter-spacing:.1em;text-transform:uppercase;
padding:3px 8px;border-radius:2px;font-weight:600}
.badge.ok{background:color-mix(in srgb,var(--ok) 16%,transparent);color:var(--ok)}
.badge.bad{background:color-mix(in srgb,var(--bad) 16%,transparent);color:var(--bad)}
.stage{padding:22px 24px;display:flex;justify-content:center;background:var(--sunk)}
.stage svg{max-width:100%;height:auto;background:#fff;border-radius:3px}
iframe{width:100%;height:520px;border:1px solid var(--rule);border-radius:3px;background:#fff}
.fail{padding:26px 24px;color:var(--bad);font-family:ui-monospace,monospace;font-size:13px}
.defect{display:flex;gap:12px;padding:13px 24px;border-bottom:1px solid var(--rule);font-size:.92rem;align-items:flex-start}
.defect .sev{font-family:ui-monospace,monospace;font-size:9.5px;letter-spacing:.11em;text-transform:uppercase;
padding:3px 7px;border-radius:2px;flex:none;font-weight:700;margin-top:2px;min-width:56px;text-align:center}
.defect.fatal .sev{background:color-mix(in srgb,var(--bad) 20%,transparent);color:var(--bad)}
.defect.major .sev{background:color-mix(in srgb,var(--accent) 20%,transparent);color:var(--accent)}
.defect.latent .sev{background:color-mix(in srgb,var(--mute) 22%,transparent);color:var(--mute)}
.defect.note .sev,.defect.none .sev{background:color-mix(in srgb,var(--ok) 18%,transparent);color:var(--ok)}
.defect code{display:block;font-size:11.5px;color:var(--faint);margin-top:5px;font-family:ui-monospace,monospace}
.defect em{display:block;font-style:italic;color:var(--mute);margin-top:4px;font-size:.9rem}
footer{color:var(--faint);font-size:.88rem;padding:40px 0 70px;border-top:1px solid var(--rule);margin-top:20px}
"""

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--out', default=os.path.join(ROOT, 'results', 'gallery.html'))
    ap.add_argument('--title', default='One-shot tests, run locally')
    args = ap.parse_args()

    idx = json.load(open(os.path.join(ROOT, 'results', 'index.json')))
    dfile = os.path.join(ROOT, 'results', 'defects.json')
    defects = json.load(open(dfile))['defects'] if os.path.exists(dfile) else {}
    idx.sort(key=lambda e: (e['id'], e['label'], e['seed']))

    parts = [f"<title>{html.escape(args.title)}</title><style>{CSS}</style>",
             "<header><div class='wrap'>",
             f"<h1>{html.escape(args.title)}</h1>",
             "<p class='sub'>The community's one-shot vibe checks, generated by a model running "
             "on one desktop GPU. Every artifact below is exactly what came back from a single "
             "request &mdash; nothing was fixed by hand, and a file that hit the token limit is "
             "marked failed rather than quietly shown.</p>"]
    labels = sorted({e['label'] for e in idx})
    ok = sum(1 for e in idx if e['valid'])
    parts.append(f"<p class='meta'>{len(idx)} runs &middot; {ok} usable &middot; "
                 f"configurations: {html.escape(', '.join(labels))}</p></div></header><div class='wrap'>")

    for e in idx:
        badge = ("<span class='badge ok'>runs</span>" if e['valid']
                 else "<span class='badge bad'>failed</span>")
        parts.append("<div class='card'><div class='head'>"
                     f"<h2>{html.escape(e['title'])}</h2>{badge}"
                     f"<span class='stats'>{html.escape(e['label'])} &middot; seed {e['seed']} &middot; "
                     f"{e['tokens']} tok &middot; {e['seconds']}s &middot; {e['tok_s']} tok/s</span>"
                     f"</div><div class='why'>{html.escape(e['why'])}</div>")
        for d in defects.get(e['file'] or '', []):
            sev = d['severity']
            parts.append(f"<div class='defect {sev}'><span class='sev'>{html.escape(sev)}</span>"
                         f"<div>{html.escape(d['what'])}"
                         + (f"<em>{html.escape(d.get('impact',''))}</em>" if d.get('impact') else '')
                         + f"<code>{html.escape(d['evidence'])}</code></div></div>")
        path = os.path.join(ROOT, 'results', e['file']) if e['file'] else None
        if not e['valid'] or not path or not os.path.exists(path):
            parts.append(f"<div class='fail'>{html.escape(e['problem'] or 'no output')}</div>")
        elif e['kind'] == 'svg':
            parts.append("<div class='stage'>" + open(path).read() + "</div>")
        else:
            doc = open(path).read()
            parts.append("<div class='stage'><iframe sandbox='allow-scripts' "
                         f"srcdoc=\"{html.escape(doc, quote=True)}\"></iframe></div>")
        parts.append("</div>")

    parts.append("<footer>Generated by <code>bin/gallery</code>. "
                 "Artifacts are unedited single-shot output.</footer></div>")
    open(args.out, 'w').write('\n'.join(parts))
    print(f"wrote {args.out}  ({os.path.getsize(args.out)//1024} KB)")

if __name__ == '__main__':
    main()
